<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📊 Hasil Perhitungan ELV625"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/tvTanggal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tanggal: "
            android:textSize="14sp"
            android:layout_marginBottom="16dp" />

        <!-- DATA HV -->
        <TextView
            android:id="@+id/tvHvData"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Data HV:"
            android:textSize="14sp"
            android:textStyle="bold"
            android:background="#f5f5f5"
            android:padding="12dp"
            android:layout_marginBottom="16dp" />

        <!-- SECTION H1 -->
        <TextView
            android:id="@+id/tvAmbangBatasH1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="AMBANG BATAS HV1:"
            android:textSize="12sp"
            android:background="#e8f4fd"
            android:padding="12dp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvPergerakanH1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pergerakan: "
            android:textSize="12sp"
            android:padding="8dp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvStatusH1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="KONDISI: "
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="#f0f8f0"
            android:padding="8dp"
            android:layout_marginBottom="16dp" />

        <!-- SECTION H2 -->
        <TextView
            android:id="@+id/tvAmbangBatasH2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="AMBANG BATAS HV2:"
            android:textSize="12sp"
            android:background="#e8f4fd"
            android:padding="12dp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvPergerakanH2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pergerakan: "
            android:textSize="12sp"
            android:padding="8dp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvStatusH2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="KONDISI: "
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="#f0f8f0"
            android:padding="8dp"
            android:layout_marginBottom="16dp" />

        <!-- SECTION H3 -->
        <TextView
            android:id="@+id/tvAmbangBatasH3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="AMBANG BATAS HV3:"
            android:textSize="12sp"
            android:background="#e8f4fd"
            android:padding="12dp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvPergerakanH3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pergerakan: "
            android:textSize="12sp"
            android:padding="8dp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvStatusH3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="KONDISI: "
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="#f0f8f0"
            android:padding="8dp"
            android:layout_marginBottom="16dp" />



        <!-- TOMBOL TUTUP -->
        <Button
            android:id="@+id/btnClose"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TUTUP"
            android:layout_gravity="center"
            android:background="@color/design_default_color_primary"
            android:textColor="@android:color/white" />

    </LinearLayout>
</ScrollView>