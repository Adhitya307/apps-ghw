<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="0dp"
    android:background="@drawable/dialog_background"
    android:layout_margin="20dp">

    <!-- HEADER -->
    <LinearLayout
        android:id="@+id/dialog_header"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:gravity="center_vertical"
        android:background="@color/pln_info">

        <ImageView
            android:id="@+id/dialog_icon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginEnd="10dp"
            android:src="@drawable/ic_calculate"
            android:tint="@android:color/white"/>

        <TextView
            android:id="@+id/dialog_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Hasil Perhitungan ELV625"
            android:textColor="@android:color/white"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/dialog_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AMAN"
            android:textStyle="bold"
            android:textSize="12sp"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:background="@drawable/status_background"
            android:textColor="@android:color/white"/>
    </LinearLayout>

    <!-- CONTENT -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="420dp"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/dialog_tanggal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tanggal: -"
                android:textColor="#333333"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Data HV:"
                android:textColor="#333333"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/dialog_hv1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="HV1: -"
                    android:textSize="13sp"
                    android:textColor="#666666"/>

                <TextView
                    android:id="@+id/dialog_hv2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="HV2: -"
                    android:textSize="13sp"
                    android:textColor="#666666"/>

                <TextView
                    android:id="@+id/dialog_hv3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="HV3: -"
                    android:textSize="13sp"
                    android:textColor="#666666"/>
            </LinearLayout>

            <TextView
                android:id="@+id/dialog_pergerakan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Pergerakan: -"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#1976D2"
                android:background="#e8f4fd"
                android:padding="12dp"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:id="@+id/dialog_keterangan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Keterangan: -"
                android:textSize="13sp"
                android:textColor="#666666"
                android:lineSpacingExtra="4dp"/>
        </LinearLayout>
    </ScrollView>

    <!-- FOOTER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="end"
        android:background="#f5f5f5">

        <Button
            android:id="@+id/dialog_button_ok"
            android:layout_width="120dp"
            android:layout_height="42dp"
            android:text="TUTUP"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:background="@drawable/button_primary"/>
    </LinearLayout>

</LinearLayout>
