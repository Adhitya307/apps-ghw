<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ====== Base App Theme ====== -->
    <style name="Theme.App" parent="Theme.Material3.Light.NoActionBar">
        <!-- Brand Colors -->
        <item name="colorPrimary">@color/pln_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/pln_primary_dark</item>

        <item name="colorSecondary">@color/pln_accent</item>
        <item name="colorOnSecondary">@color/white</item>

        <!-- Status Bar & Navigation Bar -->
        <item name="android:statusBarColor">@color/pln_primary_dark</item>
        <item name="android:navigationBarColor">@color/pln_primary</item>

        <!-- Disable Action Bar -->
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>


    <!-- ====== Dark Mode Theme ====== -->
    <style name="Theme.App.Dark" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/pln_primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/pln_accent</item>
        <item name="colorOnSecondary">@color/white</item>
    </style>


    <!-- Overlay for App Bar Components -->
    <style name="Theme.App.AppBarOverlay" parent="ThemeOverlay.Material3.Dark.ActionBar" />

    <!-- Popup Overlay (menu, dialogs, dll) -->
    <style name="Theme.App.PopupOverlay" parent="ThemeOverlay.Material3.Light" />


    <!-- Dialog Theme -->
    <style name="CustomDialogTheme" parent="Theme.MaterialComponents.Light.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowAnimationStyle">@style/DialogAnimation</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.5</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">false</item>
    </style>

    <!-- Dialog Animations -->
    <style name="DialogAnimation">
        <item name="android:windowEnterAnimation">@android:anim/fade_in</item>
        <item name="android:windowExitAnimation">@android:anim/fade_out</item>
    </style>

    <!-- Material Button Styles -->
    <style name="ButtonRounded" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">24dp</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <style name="ButtonOutlinedRounded" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="cornerRadius">24dp</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <!-- Text Styles -->
    <style name="TextTitle">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextSubtitle">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextBody">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="TextCaption">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_hint</item>
    </style>

    <!-- Status Text Styles -->
    <style name="StatusSafe">
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/status_safe</item>
    </style>

    <style name="StatusWarning">
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/status_warning</item>
    </style>

    <style name="StatusDanger">
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/status_danger</item>
    </style>

</resources>
